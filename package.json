{
  "name": "@stockearly/backend",
  "version": "0.1.0",
  "description": "Stockearly backend service implementing event-driven inventory management APIs.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "seed:roles": "node scripts/seedRoles.js",
    "seed:users": "node scripts/seedUsers.js",
    "seed:ingredients": "node scripts/seedIngredients.js",
    "seed:menu": "node scripts/seedMenu.js",
    "seed:suppliers": "node scripts/seedSuppliers.js",
    "seed:events": "node scripts/seedEvents.js",
    "seed:clear": "node scripts/clearData.js",
    "seed:all": "npm run seed:roles && npm run seed:ingredients && npm run seed:menu && npm run seed:suppliers && npm run seed:events",
    "qmarero:ventas": "node scripts/qmareroVentasHoy.js",
    "test:invoices": "node scripts/testInvoiceProcessor.js"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "firebase-admin": "^13.6.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.4.0",
    "nodemon": "^3.1.4"
  }
}