# Servidor
PORT=4000
NODE_ENV=production

# Base de datos (producción: usar MONGODB_URI_ATLAS o MONGODB_URI)
MONGODB_URI=mongodb://localhost:27017/stockcontrol
MONGODB_URI_ATLAS=

# CORS: orígenes permitidos separados por coma (incluir la URL del frontend en producción)
CLIENT_ORIGIN=https://tu-frontend.vercel.app,https://stockearly.online

# Firebase Admin (obligatorio en producción)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Opcional: desactivar auth solo en desarrollo local
# AUTH_DISABLED=true

# Opcional
LOG_LEVEL=info
